"faq.a.25" = "VoiceVista توصیف محیطی از اطراف شما را برای کمک به کاوش و مسیریابی ارائه می‌دهد. با استفاده از صدای فضایی، VoiceVista نقاط مورد علاقه، پارک‌ها، جاده‌ها و تقاطع‌ها را از جهتی که به صورت فیزیکی در محیط اطراف شما قرار دارند، هنگام راه رفتن اعلام می‌کند.\nبرای مثال، اگر از کنار یک فروشگاه در سمت راست خود عبور کنید، نام فروشگاه را از سمت راست خود خواهید شنید. با نزدیک شدن به یک تقاطع، نام هر جاده را از جهتی که به آن سمت می‌رود، از چپ، جلو و راست خواهید شنید.\nVoiceVista یک نشان صوتی را در جهت مقصد شما پخش می‌کند و به شما این قدرت را می‌دهد که با افزایش آگاهی از محیط اطراف و موقعیت مقصد خود، راه خود را به آنجا پیدا کنید. و اگر این گزینه را فعال کرده باشید، VoiceVista برای راحتی شما مسیرهای گام به گام تا مقصد بعدی را ارائه می‌دهد.";

/* No comment provided by engineer. */
"faq.a.26" = "VoiceVista برنامه‌ای برای آگاهی از محیط است که جزئیاتی را درباره پیرامون شما فراهم می‌کند. هرچند می‌تواند تا مقصد نشان صوتی راهنمای گام‌به‌گام ارائه دهد، می‌توانید آن را همراه با دیگر برنامه‌های ناوبری برای دریافت اطلاعات تکمیلی استفاده کنید.\nابتدا برنامه ناوبری را اجرا کنید. سپس به VoiceVista بروید و نشان صوتی را روی همان مقصد تنظیم کنید. هر دو برنامه هم‌زمان کار می‌کنند: برنامه ناوبری مسیر پیاده‌روی را می‌دهد و VoiceVista درباره نقاط مورد علاقه، تقاطع‌ها و فاصله تا مقصد اطلاع‌رسانی می‌کند.";

/* No comment provided by engineer. */
"faq.a.27" = "VoiceVista چند راه برای کنترل آنچه می‌شنوید و زمان شنیدن آن فراهم می‌کند:\n۱. توقف فوری همه صداها: با دو انگشت دو بار روی صفحه بزنید تا همه صداها، از جمله اعلان فعلی و نشان صوتی، متوقف شوند. اعلان‌ها در تقاطع یا نقطه مورد علاقه بعدی خودکار از سر گرفته می‌شوند، اما نشان صوتی نه. برای ادامه، «صدادار کردن نشان صوتی» را در زبانه «محیط اطراف» بزنید.\n۲. توقف اعلان‌های خودکار: وقتی در حرکت نیستید یا به مقصد رسیده‌اید، VoiceVista را در حالت چرت بگذارید تا با ترک مکان فعال شود، یا در حالت خواب بگذارید تا خودتان آن را بیدار کنید. همچنین می‌توانید «اجازه دادن به اعلان‌های صوتی خودکار» را در زبانه «تنظیمات» خاموش کنید.\n۳. توقف صدای نشان: ممکن است فقط به به‌روزرسانی فاصله نیاز داشته باشید یا بخواهید نشان را تنها نزدیک مقصد بشنوید. با «بی‌صدا کردن نشان صوتی» و «صدادار کردن نشان صوتی» در زبانه «محیط اطراف» زمان پخش آن را کنترل کنید.";

/* No comment provided by engineer. */
"faq.a.28" = "خیر! هنگام راه رفتن می‌توانید گوشی را در کیف یا جیب یا هر جایی که راحت است قرار دهید.\nVoiceVista از جهتی که راه می‌روید برای تشخیص اینکه کدام اعلان‌های صوتی را به چپ و راست شما اعلام کند، استفاده خواهد کرد.\nوقتی حرکت را متوقف می‌کنید، VoiceVista نمی‌داند رو به کدام جهت هستید. اگر نشان صوتی روشن باشد، متوجه خواهید شد که تا زمانی که دوباره شروع به حرکت کنید، صدای آن کم می‌شود.\nشما می‌توانید در هر زمان گوشی را بیرون بیاورید تا دکمه‌های موقعیت‌یابی و کاوش در پایین صفحه را فشار دهید، اما مطمئن شوید که گوشی را طوری نگه دارید که بالای آن به جهتی که رو به آن هستید اشاره کند و صفحه نمایش رو به آسمان باشد. در این حالت «صاف»، VoiceVista از قطب‌نمای گوشی برای تعیین جهت شما استفاده کرده و اعلان‌های صوتی فضایی دقیقی ارائه می‌دهد. اگر نشان صوتی روشن باشد، همچنین متوجه خواهید شد که به حجم کامل خود بازمی‌گردد.";

/* No comment provided by engineer. */
"faq.a.29" = "VoiceVista امکان شخصی‌سازی بخش‌های اصلی اعلان‌های صوتی هنگام حرکت را فراهم می‌کند:\n۱. صدا: صدا و سرعت گفتار را در «تنظیمات» > «تنظیمات عمومی» > «تنظیمات صدا» انتخاب کنید. صداهای بیشتر یا باکیفیت‌تر را از «تنظیمات iOS» > «دسترس‌پذیری» > «محتوای گفتاری» > «صداها» بارگیری کنید.\n۲. واحد فاصله: فوت یا متر را در «تنظیمات» > «تنظیمات عمومی» > «واحد اندازه‌گیری» انتخاب کنید.\n۳. نشانگرها: مکان‌های شخصی مانند خانه، محل کار یا فروشگاه دلخواه را نشان‌گذاری کنید. VoiceVista هنگام نزدیک شدن آن‌ها را خودکار اعلام می‌کند و «نشانگرهای نزدیک» اعلان فضایی نشانگرهای اطراف را می‌دهد. نشانگرها خصوصی می‌مانند.\n۴. اعلان‌ها: VoiceVista کسب‌وکارها، ایستگاه‌های اتوبوس، تقاطع‌ها و عوارض نزدیک را با صدای جهت‌دار اعلام می‌کند. آن‌ها را در «تنظیمات نقاط مورد علاقه» تنظیم کنید یا برای سکوت برنامه «اجازه دادن به اعلان‌های صوتی خودکار» را خاموش کنید.\nبرخی تنظیمات VoiceOver نیز مؤثرند:\n۱. راهنمای VoiceOver: برای شنیدن توضیح بیشتر دکمه‌های «محیط اطراف»، آن را در «تنظیمات iOS» > «دسترس‌پذیری» > VoiceOver > «پرحرفی» > «گفتن راهنما» فعال کنید.\n۲. کاهش صدای برنامه‌ها: VoiceVista با خاموش بودن این گزینه بهتر کار می‌کند. آن را در تنظیمات یا روتور VoiceOver خاموش کنید.\n۳. Touch ID یا Face ID: باز کردن قفل با زیست‌سنجی دسترسی سریع به «مکان من»، «اطراف من» و «پیش روی من» را فراهم می‌کند. آن را در تنظیمات iOS راه‌اندازی کنید.";

/* No comment provided by engineer. */
"faq.a.3" = "نشانگرها مکان‌هایی هستند که ذخیره کرده‌اید؛ چه مکان‌هایی که برنامه یافته باشد و چه مکان‌هایی که خودتان افزوده‌اید.\nبرای ذخیره مکان فعلی، زبانه «نشانگرها» را باز کنید و دکمه گوشه بالا سمت چپ را بزنید. برای ذخیره مکانی دیگر، در زبانه «محیط اطراف» «کاوش مکان‌های نزدیک» را انتخاب کنید، سپس مکان را جستجو یا از فهرست نزدیک انتخاب کنید.\nپس از یافتن مکان، آن را انتخاب کنید تا «جزئیات مکان» باز شود، سپس دکمه گوشه بالا سمت چپ را بزنید.\nهر مکان یا آدرسی را می‌توان نشان‌گذاری کرد، حتی مواردی که روی نقشه نیستند؛ مانند ورودی ساختمان یا پارک، دکمه عابر، گذرگاه، پل، ایستگاه اتوبوس یا درخت مورد علاقه حیوان خانگی. سپس می‌توانید از آن‌ها به‌عنوان مرجع در مسیر استفاده کنید.\nVoiceVista هنگام عبور یا نزدیک شدن، مکان‌های نشان‌گذاری‌شده را خودکار اعلام می‌کند. با «نشانگرهای نزدیک» در زبانه «محیط اطراف» نیز می‌توانید اعلان فضایی نشانگرهای اطراف را بشنوید.\nمی‌توانید روی هر نشانگر نشان صوتی تنظیم و آن را طبق معمول کنترل کنید.\nهمچنین می‌توانید نام نشانگر را تغییر دهید یا یادداشتی بیفزایید که همراه آن اعلام شود.";

/* No comment provided by engineer. */
"faq.a.30" = "VoiceVista از داده‌های نقشه جغرافیایی برای ارائه اعلان‌های صوتی اطلاعاتی در برنامه استفاده می‌کند. منبع اصلی نقشه‌ای که ما استفاده می‌کنیم OpenStreetMap است که یک پلتفرم نقشه‌برداری غنی است که توسط جامعه تولید شده و به سازمان‌ها و افراد امکان می‌دهد کیفیت و دقت اطلاعات ارائه شده و دسترسی به فضاهای خود را با استفاده از ابزارهای ویرایش نقشه OpenStreetMap بهبود بخشند.";

/* No comment provided by engineer. */
"faq.a.31" = "وقتی اتصال اینترنت یا خدمات VoiceVista در دسترس نیست، برنامه به حالت آفلاین می‌رود. VoiceVista همچنان کار می‌کند، اما ممکن است برخی قابلیت‌ها محدود شوند.\nاعلان‌های صوتی در مناطقی که داده نقشه آن‌ها از قبل روی دستگاه ذخیره شده ادامه می‌یابند. همچنین می‌توانید با مکان‌های «اعلان‌های صوتی اخیر» نشان صوتی یا نشانگر بسازید.\nهنگامی که گوشی اتصال پایدار Wi‑Fi یا داده تلفن همراه داشته باشد، VoiceVista تلاش می‌کند کار عادی را از سر بگیرد. در غیر این صورت ممکن است خدمات VoiceVista موقتاً در دسترس نباشند.";

/* No comment provided by engineer. */
"faq.a.32" = "بله. می‌توانید از مکان‌های BlindSquare نسخه پشتیبان تهیه و آن را به VoiceVista وارد کنید.\n۱. BlindSquare را باز کنید و به «مکان‌های من» بروید.\n۲. دکمه اقدام در گوشه بالا سمت راست را بزنید.\n۳. فایل خروجی را برای خود ایمیل کنید یا در برنامه «فایل‌ها» ذخیره کنید.\n• اگر ایمیل کردید، پیام را در Mail باز کنید، روی فایل JSON پیوست و سپس «اشتراک‌گذاری» بزنید و VoiceVista را انتخاب کنید.\n• اگر در «فایل‌ها» ذخیره کردید، VoiceVista را باز کنید و «تنظیمات» > «صدور و ورود» > «ورود فایل پشتیبان BlindSquare» را انتخاب کنید.\nفقط نام و مختصات نشانگرهای BlindSquare وارد می‌شود. اطلاعاتی مانند فاصله هشدار یا دقت ذخیره نشانگر قابل ورود نیست.";

/* No comment provided by engineer. */
"faq.a.33" = "ممکن است به این دلیل باشد که شما «حرکت و تناسب اندام» را برای همه برنامه‌ها غیرفعال کرده‌اید. برای رفع این مشکل، برنامه تنظیمات را راه‌اندازی کنید و به حریم خصوصی و امنیت بروید، حرکت و تناسب اندام را پیدا کنید و ردیابی تناسب اندام را روشن کنید.";

/* No comment provided by engineer. */
"faq.a.34" = "اگر گوشی را در جیب بگذارید و بایستید، چون VoiceVista جهت شما را تشخیص نمی‌دهد صدای نشان کمتر می‌شود. دوباره حرکت کنید یا گوشی را بیرون بیاورید و صاف نگه دارید.\nمی‌توانید روی هر آدرس نشان صوتی تنظیم کنید. آدرس را در زبانه «محیط اطراف» جستجو و از نتایج انتخاب کنید، سپس در صفحه «جزئیات مکان» «شروع نشان صوتی» را بزنید. روی کسب‌وکارها، مکان‌ها، نقاط مورد علاقه و خانه‌هایی که در OpenStreetMap نیستند نیز می‌توان نشان گذاشت.\nبرای یافتن ایستگاه اتوبوس نزدیک، فیلتر «حمل‌ونقل عمومی» را در «کاوش مکان‌های نزدیک» انتخاب کنید.\nبرای قطع صدای آهنگین نشان، «بی‌صدا کردن نشان صوتی» را در زبانه «محیط اطراف» بزنید. به‌روزرسانی فاصله تا مقصد تقریباً هر ۵۰ متر ادامه می‌یابد.\nبرای استفاده بدون اعلان خودکار، «اجازه دادن به اعلان‌های صوتی خودکار» را در زبانه «تنظیمات» خاموش کنید. اگر از VoiceVista استفاده نمی‌کنید، «خواب» را در زبانه «محیط اطراف» انتخاب کنید تا وارد حالت خواب یا چرت شوید.\nVoiceVista زمانی بهترین عملکرد را دارد که گوشی را صاف، با صفحه رو به آسمان و بالای گوشی دور از خود نگه دارید.\nبرای مسیر اتوبوسی همیشگی، ایستگاه سوار و پیاده شدن را به‌عنوان نشانگر ذخیره کنید. می‌توانید آن‌ها را در زبانه «نشانگرها» بیابید، نشان صوتی تنظیم کنید و با نزدیک شدن به ایستگاه مقصد به‌روزرسانی دریافت کنید. بی‌صدا کردن نشان، اعلان فاصله را متوقف نمی‌کند.\nبرای بی‌صدا کردن اعلان فعال، با دو انگشت دو بار روی صفحه بزنید.";

/* No comment provided by engineer. */
"faq.a.4" = "مسیر مجموعه‌ای از نقاط مسیر است. VoiceVista رسیدن به هر نقطه را اعلام می‌کند و نشان صوتی خودکار به نقطه بعدی می‌رود.\nمی‌توانید برای حفظ مسیر در منطقه‌ای آشنا یک مسیر بسازید، یا برای یادگیری راهی ناآشنا از آن استفاده کنید.\nبرای ساخت مسیر، زبانه «مسیرها» را باز کنید و در گوشه بالا سمت چپ «افزودن» را بزنید. نام و توضیح اختیاری وارد کنید، سپس هنگام حرکت نقطه مسیر بیفزایید یا از نشانگرها انتخاب کنید. با ویرایش مسیر می‌توانید هر زمان ترتیب نقاط را تغییر دهید.\nروش‌های پیشرفته ساخت مسیر شامل الگوریتم مسیریابی، وارد کردن فایل GPX و حالت ثبت مسیر است.\nبرای ویرایش، مسیر را در زبانه «مسیرها» انتخاب کنید و سپس «ویرایش نام مسیر» یا «ویرایش نقاط مسیر» را در گوشه بالا سمت چپ بزنید. می‌توانید نقاط را اضافه یا حذف و نام و توضیح را ویرایش کنید.\nبرای اشتراک‌گذاری، مسیر را در زبانه «مسیرها» انتخاب کنید و «اشتراک‌گذاری» را بزنید.";

