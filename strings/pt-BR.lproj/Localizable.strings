/* general.error.heading */
"VoiceVista is not sure which direction you are facing. Hold your phone flat or begin walking, then try again." = "O VoiceVista não tem certeza para qual direção você está virado. Por favor, segure o telefone na horizontal ou comece a caminhar e tente novamente";

/* No comment provided by engineer. */
"VoiceVista is offline. Some features are limited." = "Sem conexão com a internet; algumas funções são limitadas no modo offline.";

/* devices.callouts.check_audio.airpods.disconnected */
